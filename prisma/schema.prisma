generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserProfile {
  id            String   @id
  email         String   @unique
  createdAt     DateTime @default(now())
  householdId   String?
  householdRole String?  // "worker" | "hive" (null = queen/solo)

  plaidItems      PlaidItem[]
  incomes         Income[]
  bills           Bill[]
  groceries       GroceryItem[]
  budgetSettings  BudgetSettings?
  incomeEntries   IncomeEntry[]
  splitExpenses   SplitExpense[]
  ownedHousehold  Household?
  household       Household?      @relation("HouseholdMembers", fields: [householdId], references: [id], onDelete: SetNull)
}

model PlaidItem {
  id              String   @id @default(cuid())
  userId          String
  accessToken     String
  itemId          String
  institutionName String?
  createdAt       DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  plaidId      String?  @unique
  name         String
  amount       Float
  date         DateTime
  category     String?
  merchantName String?
  type         String
  source       String
  createdAt    DateTime @default(now())
}

model Income {
  id        String   @id @default(cuid())
  userId    String
  name      String
  amount    Float
  cadence   String
  source    String
  createdAt DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bill {
  id        String    @id @default(cuid())
  userId    String
  name      String
  amount    Float
  dueDay    Int?
  cadence   String
  source    String
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GroceryItem {
  id             String   @id @default(cuid())
  userId         String
  name           String
  quantity       Int      @default(1)
  estimatedPrice Float?
  store          String   @default("walmart")
  status         String   @default("planned")
  createdAt      DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BudgetSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  groceryPercent   Float    @default(25)
  savingsGoal      Float    @default(0)
  displayName      String?
  payPeriod        String   @default("biweekly")
  householdAdults  Int      @default(2)
  householdKids    Int      @default(0)
  preferredStore   String   @default("")
  savedMealPlan    Json?
  savedLists       Json?
  frequentItems    Json?
  shareToken       String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Household {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  workerCode  String?  @unique
  hiveCode    String?  @unique
  createdAt   DateTime @default(now())

  owner   UserProfile   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members UserProfile[] @relation("HouseholdMembers")
}

model IncomeEntry {
  id         String   @id @default(cuid())
  userId     String
  sourceName String
  amount     Float
  receivedAt DateTime
  note       String?
  createdAt  DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SplitExpense {
  id        String   @id @default(cuid())
  userId    String
  name      String
  total     Float
  yourShare Float
  paidBy    String   @default("me")
  people    Json     @default("[]")
  settled   Boolean  @default(false)
  createdAt DateTime @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}
